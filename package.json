{
  "name": "nyam-nyam",
  "version": "1.0.0",
  "description": "A responsive web project featuring traditional Catalan recipes",
  "repository": {
    "type": "git",
    "url": "https://github.com/lgtapias/nyamnyam.git"
  },
  "keywords": [],
  "author": "Lola Garcia Tàpias <lolagarciatapias@uoc.edu> (https://github.com/lgtapias)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lgtapias/nyamnyam/issues"
  },
  "homepage": "https://github.com/lgtapias/nyamnyam#readme",
  "scripts": {
    "clean": "rimraf dist .parcel-cache",
    "start": "npm run clean && parcel src/index.html",
    "build": "npm run clean && parcel build src/index.html --dist-dir dist --public-url ./ --no-content-hash",
    "serve": "http-server dist",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.14.4",
    "@parcel/transformer-sass": "^2.14.4",
    "@parcel/transformer-webmanifest": "^2.14.4",
    "gh-pages": "^4.0.0",
    "http-server": "^14.0.0",
    "parcel": "^2.14.4",
    "rimraf": "^6.0.1",
    "sass": "^1.87.0",
    "svgo": "^3.3.2"
  },
  "staticFiles": {
    "staticPath": [
      "src/fonts",
      "src/assets"
    ],
    "watcherGlob": "**/*.{woff2,woff,ttf,png,jpg,svg}"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "sharp": "^0.33.5",
    "swiper": "^11.2.6",
    "uniq": "^1.0.1"
  },
  "type": "commonjs"
}
